# Copy to deploy/.env and adjust. Secrets live in deploy/secrets/ (see gen-secrets.sh), not here.
MEMGRAPH_USER=sandman
# live | record | replay (LLM record/replay, ADR-0010)
SANDMAN_LLM_MODE=live
# experiment name: cassettes go to data/llm-records/<name>
SANDMAN_EXPERIMENT=default
# host directory mounted at /llm-records (relative paths resolve against deploy/); make e2e uses tests/cassettes
SANDMAN_LLM_RECORDS_HOST_DIR=../data/llm-records
# optional JSONL log file inside containers (mounted from data/logs)
SANDMAN_LOG_FILE=
# numeric group that owns data/logs (setgid, 2770) and is added to every log-writing container
SANDMAN_LOG_GID=10001
# tracing and metrics (profile obs: docker compose --profile obs up): set OTEL_SDK_DISABLED=false and
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318 (OTLP/HTTP); Grafana on http://127.0.0.1:3001 (admin/admin).
# OTEL_SDK_DISABLED=false without an endpoint is rejected by deploy/check-env.sh (make up).
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
# CoreNLP (T2.5): remote = KIT instance, user:password in deploy/secrets/corenlp_credentials (make up fails while it holds
# the placeholder); local = container of the compose profile corenlp-local (make adds the profile). No other value is valid.
SANDMAN_CORENLP_MODE=remote
SANDMAN_CORENLP_URL=https://vdl-ws.sdq.kastel.kit.edu
