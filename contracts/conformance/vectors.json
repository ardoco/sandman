            {
              "key": "art_aa#REQ-2",
              "contentHash": "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb"
            },
            {
              "key": "art_aa#REQ-2",
              "contentHash": "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb"
            },
            {
              "key": "art_aa#REQ-1",
              "contentHash": "2e7d2c03a9507ae265ecf5b5356885a53393a2029d241394997265a1a25aefc6"
            }
          ],
          "links": [
            {
              "sourceKey": "art_aa#REQ-2",
              "targetKey": "art_bb#mini.MediaCache",
              "endpoints": [
                {
                  "key": "art_aa#REQ-2",
                  "contentHash": "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb"
                },
                {
                  "key": "art_bb#mini.MediaCache",
                  "contentHash": "3e23e8160039594a33894f6564e1b1348bbd7a0088d42c4acb73eeaed59c009d"
                }
              ]
            }
          ]
