          {
            "provider": "ollama",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          }
        ]
      },
      {
        "id": "vk-tlr",
        "name": "tlr",
        "value": "env.VK_TLR",
        "is_active": true,
        "rate_limit_id": "rl-heavy",
        "provider_configs": [
          {
