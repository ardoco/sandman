  "claims": [
    {
      "id": "claim_e44d811ecec641868895e9ec15336f9f",
      "statement": "llm-replay is the single OpenAI-compatible live/record/replay proxy in front of the LLM gateway through which all SANDMAN LLM callers reach LLMs (every agent's SANDMAN_LLM_BASE_URL points at it, e.g. http://llm-replay:8000/openai); ADR-0010 amendment D-3 moved record/replay out of the agent libraries into this proxy so it also covers LangChain4j inside reused LiSSA/ArDoCo Java code and the embeddings endpoint.",
      "evidence": [
        {
          "resource": "repo://adr/0010-minimal-agent-library.md#L93-L93",
          "version": "repo-lines-v1:sha256:bb7543cece3174ec76528c8d9a3b7fae7d4fcc484a7788b81e2ffe8eff2e0316:"
        },
        {
          "resource": "repo://deploy/docker-compose.yml#L9-L10",
          "version": "repo-lines-v1:sha256:b3b2d5ba8247dba188cd2c2d4654df751afa2de3d615d98831d2e8988153053a:"
        },
        {
          "resource": "repo://services/llm-replay/src/sandman_llm_replay/app.py#L1-L1",
          "version": "repo-lines-v1:sha256:5ae95a6dfc7273b56a83ec8e7eebbc1f1a747b25c6590df4db1d5500d9ab6ae4:"
        }
      ]
    },
    {
      "id": "claim_50c134ec9ffc47e4a343b87cfc8cf339",
      "statement": "SANDMAN_LLM_MODE selects live, record or replay (default live); an invalid value aborts startup, and SANDMAN_LLM_UPSTREAM (the gateway's OpenAI base URL) is required in live and record mode but optional in replay mode, where it is never used.",
      "evidence": [
        {
          "resource": "repo://services/llm-replay/src/sandman_llm_replay/app.py#L34-L51",
          "version": "repo-lines-v1:sha256:c66e88b18e42608aa1a8141168a5087ebe2c2c144792eee6382b637e431adc52:"
        }
      ]
    },
    {
      "id": "claim_f772570255874a8084b4850dcbc4005d",
      "statement": "The cassette lookup key is sha256 hex of the RFC 8785 (JCS) serialization of the request body after removing the members user, stream and stream_options, so the same prompt re-run under a different run id (the user field) hits the same cassette; the key is computed from the body only, without the endpoint or headers.",
      "evidence": [
        {
          "resource": "repo://contracts/common.schema.json#L122-L155",
          "version": "repo-lines-v1:sha256:bdf6e100ab578c1cd969a1c9dc12893525cb42173bbdde30656382bc79e3f380:"
        },
        {
          "resource": "repo://contracts/conformance/vectors.json#L147-L148",
          "version": "repo-lines-v1:sha256:aa7ffee8ab62cb3402bec0e05837f94d29745a3a44fc001a1d0e6d8080995a0a:"
        },
        {
          "resource": "repo://services/llm-replay/src/sandman_llm_replay/app.py#L24-L60",
          "version": "repo-lines-v1:sha256:528f367000ec19a13f1f31ca88ce77b41bb8cbe70ef35ba266b33aef1c801ff3:"
        }
      ]
    },
    {
      "id": "claim_97e639d0ec244f53b56ba002408b97e8",
      "statement": "Because the recorded request body contains the gateway model name (resolved from the logical route), re-pointing a route in models.yaml changes cassette keys and invalidates previously recorded cassettes instead of replaying stale answers.",
      "evidence": [
        {
          "resource": "repo://adr/0010-minimal-agent-library.md#L93-L93",
          "version": "repo-lines-v1:sha256:bb7543cece3174ec76528c8d9a3b7fae7d4fcc484a7788b81e2ffe8eff2e0316:"
        },
        {
          "resource": "repo://contracts/common.schema.json#L142-L148",
          "version": "repo-lines-v1:sha256:70950195c9cce60ed956827ca6614c7eeeee2d092f082a51412b6f3f402aae1f:"
        }
      ]
    },
    {
      "id": "claim_d68f0b35eb874e0c86e60d3fdda3d83a",
      "statement": "Only POST requests to chat/completions and embeddings participate in record/replay; in live mode everything is streamed through to the upstream unchanged, and in replay mode any non-recordable request (e.g. GET /openai/models) is answered with 404 replay_miss without ever calling the upstream, making replay strictly offline.",
      "evidence": [
        {
          "resource": "repo://services/llm-replay/src/sandman_llm_replay/app.py#L142-L169",
          "version": "repo-lines-v1:sha256:c2990c5b58c6a313d46868cad6f2a9f9893e978abcfd5255349768a74ee3ef59:"
        }
      ]
    },
    {
      "id": "claim_4d438409ae1e48f88d080d69c7b06438",
      "statement": "In record and replay mode a request body that is not a JSON object is rejected with 400 invalid_json, and stream: true is rejected with 400 streaming_not_supported before any upstream call; a cassette miss in replay mode returns 404 replay_miss with the computed key in the error body, and an upstream transport failure (httpx error) becomes 502 upstream_error/upstream_unreachable.",
      "evidence": [
        {
          "resource": "repo://services/llm-replay/src/sandman_llm_replay/app.py#L149-L169",
          "version": "repo-lines-v1:sha256:2f8cfd8a9efdf9ff9e7f5b445b56e9d4dd2aa351a3f4d4ca290eb5104837b893:"
        },
        {
          "resource": "repo://services/llm-replay/src/sandman_llm_replay/app.py#L179-L193",
          "version": "repo-lines-v1:sha256:3a01c77a20e84c0c127f9b0e5f93c20d11e3230ec3d8fddb24cd236bfd19f2a1:"
        }
      ]
    },
    {
      "id": "claim_bf75d69d518346c9b5fd2e1d8e6eac01",
      "statement": "Record mode forwards the request non-streaming and appends one CassetteEntry to cassette.jsonl (under an asyncio lock) only when the upstream answered HTTP 200 with a JSON object body; non-200 responses and non-object bodies are passed through unrecorded (outcome forwarded).",
      "evidence": [
        {
          "resource": "repo://services/llm-replay/src/sandman_llm_replay/app.py#L122-L140",
          "version": "repo-lines-v1:sha256:496cbd276032e119f2643bf0c00743945f6d46d3e524cb12c2851fb6e0c6797a:"
        }
      ]
    },
    {
      "id": "claim_29b0fed85bd74bfeaa6ba726267828c0",
      "statement": "The cassette is consulted before the upstream even in record mode: a request whose key is already loaded (or recorded earlier in the same process) is served from the cassette, so re-recording a changed prompt requires deleting the old cassette line or using a fresh experiment directory.",
      "evidence": [
        {
          "resource": "repo://services/llm-replay/src/sandman_llm_replay/app.py#L162-L169",
          "version": "repo-lines-v1:sha256:e3d5062097aa7d855c7218e7b725c0b6cad69c31dffc1dddcf100012a13c9138:"
        },
        {
          "resource": "repo://services/llm-replay/tests/test_app.py#L75-L81",
          "version": "repo-lines-v1:sha256:18d599b9127f985f43eac05bf97a466a28b5521438bc1a8522e2158813ca438b:"
        }
      ]
    },
    {
      "id": "claim_363a210cd3ad4ad2a13afb37d4309401",
      "statement": "Cassettes are JSONL files under SANDMAN_LLM_RECORDS_DIR (one per-experiment subdirectory, compose default /llm-records/${SANDMAN_EXPERIMENT:-default}); at startup in record and replay mode all *.jsonl files are loaded into one key-to-entry map (later files and lines overwrite earlier entries with the same key), and a non-blank line that is not an object carrying all five members key, endpoint, request, response, recordedAt aborts startup with a file:line error message.",
      "evidence": [
        {
          "resource": "repo://contracts/common.schema.json#L122-L155",
          "version": "repo-lines-v1:sha256:bdf6e100ab578c1cd969a1c9dc12893525cb42173bbdde30656382bc79e3f380:"
        },
        {
