{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandman.invalid/contracts/config/query-strategies.schema.json",
  "title": "config/query/strategies.yaml",
  "description": "Enabled query strategies and their budgets (ADR-0018). A strategy that is disabled or not implemented answers 501. Missing file = only cypher enabled.",
  "type": "object",
  "properties": {
    "classifierThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "strategies": {
      "type": "object",
      "properties": {
        "cypher": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "intentsFirst": { "type": "boolean" },
            "maxRepairs": { "type": "integer", "minimum": 0, "maximum": 5 },
            "maxExamples": { "type": "integer", "minimum": 0, "maximum": 50 }
          },
          "additionalProperties": false
        },
        "graphrag": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "explore": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
