    {
      "id": "claim_7b9b15fb455d400f98c097a2b0d9f339",
      "statement": "All developer entry points are make targets: secrets (deploy/gen-secrets.sh, never overwrites), infra (memgraph/nats/llm-gateway with dev ports), up/down/logs (docker compose -f deploy/docker-compose.yml), images (--profile stubs build), test = test-py (uv run pytest) + test-java (mvn -B verify), lint = guard + ruff check + ruff format --check + mypy libs/python, contracts (scripts/validate_contracts.py), and backup which intentionally exits 1 as a T5.3 placeholder.",
      "evidence": [
        {
          "resource": "repo://Makefile#L8-L50",
