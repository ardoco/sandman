    {
      "id": "claim_94321f53b4d2481285621b8ee010ec0e",
      "statement": "safe_path rejects absolute paths, backslashes, NULs and empty/dot/dot-dot segments; read_archive accepts only zip or tar(.gz) regular files (no symlinks or special files, stdlib tarfile.data_filter applied), rejects duplicate entries, caps entries at 2*MAX_FILES and total content at max_bytes with HTTP 400, and the HTTP handler reads at most max_archive_bytes+1 up front so oversized archives are rejected early.",
      "evidence": [
