    {
      "id": "claim_06a67c95263b4cbcbf0176d36f3f0ad0",
      "statement": "The query-service Middleware wraps every HTTP request in tracker.track() except paths in QUIET = {\"/healthz\", \"/readyz\", \"/v1/status\"}, so monitoring endpoints are not counted as in-flight requests and polling /v1/status does not distort the working/idle value it returns.",
