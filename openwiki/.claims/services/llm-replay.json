          "version": "repo-lines-v1:sha256:65a603a88656614ba7085c27b53829497a6bb1104751f0db44a7b0664495536f:"
        }
      ]
    },
    {
      "id": "claim_71b8b0800efc4ac59e4282b526ea2ee9",
      "statement": "GET /v1/status requires a Bearer service token whose sha256 matches (constant-time via hmac.compare_digest) any of the values in the SANDMAN_SERVICE_VERIFY_FILE JSON mapping of caller name to token hash; without or with a wrong token it returns 401.",
      "evidence": [
        {
          "resource": "repo://deploy/gen-secrets.sh#L50-L61",
          "version": "repo-lines-v1:sha256:36b9dad059d18ea023ae3961eb84756c4ba1159ca4584a8aa27a00802ba45d62:"
