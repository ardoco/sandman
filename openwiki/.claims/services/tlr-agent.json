    {
      "id": "claim_60395344dfba4499afd112c46eb2d398",
      "statement": "In-process trace-link approaches implement the TraceLinkApproach SPI (id, version, supported KindPairs, recover(TlrInput, TlrContext), optional usesLlm) and are discovered via java.util.ServiceLoader; approaches are pure computations that receive the loaded elements plus a context (effective params, cancellation flag, logger, optional LlmAccess/ArtifactStore) and return CandidateLinks — the agent, not the approach, assigns link ids, writes the KG and records provenance.",
      "evidence": [
        {
          "resource": "repo://services/tlr-agent/src/main/java/edu/kit/kastel/mcse/ardoco/sandman/tlr/TlrContext.java",
          "version": "repo-file-v1:sha256:ae50c8ccd65a8738eca4292b698b4a75016fffaf00973f37408f89e8568a016d"
