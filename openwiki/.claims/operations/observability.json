        }
      ]
    },
    {
      "id": "claim_a505ccb00d3f4213b71750108b634880",
      "statement": "StatusTracker (both the Python library and the Java agent-lib) counts in-flight tasks via track() and reports state working iff activeTasks > 0, stamping lastActivityAt on entry and exit; the Python track() is an async context manager, the Java track() returns a close-exactly-once AutoCloseable Active handle.",
      "evidence": [
        {
          "resource": "repo://libs/java/agent-lib/src/main/java/edu/kit/kastel/mcse/ardoco/sandman/agent/StatusTracker.java",
          "version": "repo-file-v1:sha256:35f3aa7b1721a0dbd2dd52bccc44a4fbdc93bdfa8702223129b0b6aa81bff4ee"
