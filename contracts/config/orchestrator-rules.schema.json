{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandman.invalid/contracts/config/orchestrator-rules.schema.json",
  "title": "config/orchestrator/rules.yaml",
  "description": "Orchestrator rule configuration; the rules themselves are fixed in code. Contract version 0.9.0.",
  "type": "object",
  "properties": {
    "debounceSeconds": {
      "type": "number",
      "minimum": 0
    },
    "maxConcurrentPerAgent": {
      "type": "integer",
      "minimum": 1
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/duration"
      },
      "description": "Skill id -> step timeout."
    },
    "poll": {
      "type": "object",
      "properties": {
        "initial": {
          "$ref": "#/$defs/duration"
        },
        "max": {
          "$ref": "#/$defs/duration"
        }
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "backoff": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/duration"
          }
        }
      },
      "additionalProperties": false
    },
    "tlr": {
      "type": "object",
      "properties": {
        "kindPairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "$ref": "https://sandman.invalid/contracts/common.schema.json#/$defs/ArtifactKind"
              },
              "target": {
                "$ref": "https://sandman.invalid/contracts/common.schema.json#/$defs/ArtifactKind"
              },
              "approaches": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "modelDerivation": {
      "type": "object",
      "description": "Derived architecture models (T2.7). enabled false stops new derivations; existing derived artifacts stay.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "projects": {
          "type": "object",
          "description": "Project id -> overrides.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "description": "Scheduled prune workflows (T5.2). Defaults: enabled, dryRun true, 24h, 20 versions per artifact.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "$ref": "#/$defs/duration"
        },
        "keepVersionsPerArtifact": {
          "type": "integer",
          "minimum": 1
        },
        "dryRun": {
          "type": "boolean"
        },
        "experimentsDir": {
          "type": "string",
          "description": "Directory with experiments/<name>/experiment.yaml; its snapshot content hashes protect versions."
        },
        "projects": {
          "type": "object",
          "description": "Project id -> overrides.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "keepVersionsPerArtifact": {
                "type": "integer",
                "minimum": 1
              },
              "dryRun": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "duration": {
      "description": "Duration: number of seconds or a string like 30s, 2m, 1h (ms accepted by the Java loader).",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)?\\s*$"
        }
      ]
    }
  }
}
