<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ardoco</groupId>
    <artifactId>sandman-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>sandman-tlr-approach-ardoco</artifactId>
  <name>TLR approach ardoco.</name>

  <dependencies>
    <dependency>
      <groupId>io.github.ardoco</groupId>
      <artifactId>sandman-ardoco-shadow</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ardoco</groupId>
      <artifactId>sandman-tlr-approach-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ardoco</groupId>
      <artifactId>sandman-agent-lib-a2a</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ardoco</groupId>
      <artifactId>sandman-ardoco-text</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ardoco</groupId>
      <artifactId>sandman-ardoco-text</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.ardoco.tlr</groupId>
      <artifactId>pipeline-tlr</artifactId>
      <version>${ardoco.version}</version>
      <exclusions>
        <!-- Only the code extractors of model-provider use them (Magika file typing, JDT Java parsing); SWATTR reads PCM and UML. -->
        <exclusion>
          <groupId>io.github.ardoco</groupId>
          <artifactId>magika</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.microsoft.onnxruntime</groupId>
          <artifactId>onnxruntime</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.eclipse.jdt</groupId>
          <artifactId>org.eclipse.jdt.core</artifactId>
        </exclusion>
        <!-- Removes the code jar and the models jar (464 MB): CoreNLP annotates in the provider service (T2.5). -->
        <exclusion>
          <groupId>edu.stanford.nlp</groupId>
          <artifactId>stanford-corenlp</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- The code jar again, without the models: ArDoCo's text classes (CoreNLP-based TextImpl and others) still link against it. -->
    <dependency>
      <groupId>edu.stanford.nlp</groupId>
      <artifactId>stanford-corenlp</artifactId>
    </dependency>
    <!-- Only for CorenlpParityTest (manual, -Dcorenlp.parity=true); the models never enter the image. -->
    <dependency>
      <groupId>edu.stanford.nlp</groupId>
      <artifactId>stanford-corenlp</artifactId>
      <version>${corenlp.version}</version>
      <classifier>models</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <ardoco.version>${ardoco.version}</ardoco.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <!-- CorenlpProvider (Testcontainers) is shared with the tlr-agent tests. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
            <configuration>
              <excludes>
                <!-- stand-in for Magika in this module's tests only; the tlr-agent must not see it (ModuleRulesTest) -->
                <exclude>edu/kit/kastel/mcse/ardoco/magika/**</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <configuration>
              <rules>
                <!-- R-030: LangChain4j comes in through ArDoCo's model-provider; other frameworks stay banned. -->
                <bannedDependencies>
                  <excludes combine.self="override">
                    <exclude>org.springframework.ai</exclude>
                    <exclude>org.bsc.langgraph4j</exclude>
                    <!-- T2.6: code extraction (JDT, Magika, onnxruntime) lives in services/code-extractor-ardoco only. -->
                    <exclude>org.eclipse.jdt</exclude>
                    <exclude>com.microsoft.onnxruntime</exclude>
                    <exclude>io.github.ardoco:magika</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
