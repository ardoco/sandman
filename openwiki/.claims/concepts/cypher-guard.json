    {
      "id": "claim_c8dd763ef5764cb08d8aa2ec40e60a05",
      "statement": "Project anchoring invariant: in scoped mode every connected component of every pattern (MATCH/OPTIONAL MATCH, pattern predicate, pattern comprehension, EXISTS subquery) must contain a node with {projectId: $projectId} (exactly that bare parameter), a (:Project {id: $projectId}) node, or a variable bound by an earlier anchored pattern; WITH only keeps bare-projected variables and UNWIND/comprehension variables shadow outer ones. This relies on the writer invariant that no relationship crosses projects.",
      "evidence": [
        {
          "resource": "repo://docs/notes/cypher-guard.md#L31-L36",
          "version": "repo-lines-v1:sha256:3f7c1fb6633e734f9e5006a775559ca79530f530cb0d16df2c74af95373ff8d7:"
        },
