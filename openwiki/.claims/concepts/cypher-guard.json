    {
      "id": "claim_04c7c03c1d004134926aae4e12eff0ad",
      "statement": "Memgraph's read transaction is the primary write guard because Memgraph Community has no read-only roles: it blocks CREATE/SET/DELETE/REMOVE/MERGE, but DUMP DATABASE and read-only CALL procedures still run in a read transaction, which is why the clause allowlist (DENIED set) covers them; integration tests verify writes fail even with the in-service guard bypassed.",
      "evidence": [
        {
          "resource": "repo://adr/0009-nl-to-cypher.md#L10-L10",
          "version": "repo-lines-v1:sha256:c04211adef9aa180d1822448b6f12705f7fd6079a79518260bf7fa443b4b5d75:"
