          "version": "repo-lines-v1:sha256:503365640790aaab4d7f9806d2efa765345283974a5a771b471d8acd979b20b6:"
        }
      ]
    },
    {
      "id": "claim_bf34604672b64e8582df0d08ef32774c",
      "statement": "Forwarding preserves the method, query string and headers (including the caller's Authorization header, i.e. the gateway virtual key) except the hop-by-hop set plus host and content-length; the proxy holds no LLM keys of its own and does not authenticate the proxy path, and it uses a 600 s total / 10 s connect timeout to the upstream.",
      "evidence": [
        {
          "resource": "repo://services/llm-replay/src/sandman_llm_replay/app.py#L28-L31",
          "version": "repo-lines-v1:sha256:bcdb0fafa6d8d49d3538fe16ee19bf7ade632eba66b1f2c7c6253d5892e711a7:"
        },
        {
