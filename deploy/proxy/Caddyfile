# edge-proxy: the only container with published ports besides the gateway UI (spike T0.4 check 13).
# query-service, dashboard and Grafana stay on the internal network without egress.
{
	admin off
	auto_https off
}

:8080 {
	reverse_proxy query-service:8000
}

:8090 {
	reverse_proxy dashboard:8000
}

:3001 {
	reverse_proxy otel-lgtm:3000
}
