  "actionKey": {
    "rule": "sha256 hex of UTF-8(JCS({agent, skill, input, triggerId})); triggerId = id of the triggering event or of the manual request. (Replaces the earlier array form [agent, skill, input, triggerId].)",
    "cases": [
      {
        "name": "event trigger",
        "object": {
          "agent": "tlr-agent",
          "skill": "recover-trace-links",
          "input": {
            "projectId": "mini",
            "sourceVersionIds": [
              "ver_0123456789abcdef0123456789abcdef"
            ],
            "targetVersionIds": [
              "ver_fedcba9876543210fedcba9876543210"
            ]
          },
          "triggerId": "evt_0123456789abcdef0123456789abcdef"
        },
        "canonical": "{\"agent\":\"tlr-agent\",\"input\":{\"projectId\":\"mini\",\"sourceVersionIds\":[\"ver_0123456789abcdef0123456789abcdef\"],\"targetVersionIds\":[\"ver_fedcba9876543210fedcba9876543210\"]},\"skill\":\"recover-trace-links\",\"triggerId\":\"evt_0123456789abcdef0123456789abcdef\"}",
        "expected": "95080a39d57cf0ec65376845c3c15780187b6185a59cdb8bb3f672d60bd08b2e"
