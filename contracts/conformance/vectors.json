  "inputKey": {
    "rule": "sha256 hex of UTF-8(JCS({input, tool, configHash} plus promptIds when the tool uses prompt templates)). input = the skill input exactly as received; tool = extractor/approach/detector id or the plugin's config id; configHash per kg/schema.yaml conventions.derivations. Member order in the object is irrelevant (JCS sorts).",
    "cases": [
      {
        "name": "extraction, built-in extractor",
        "skill": "extract-artifact-versions",
        "object": {
          "input": {
            "projectId": "mini",
            "artifactVersionIds": [
              "ver_0123456789abcdef0123456789abcdef"
            ]
          },
          "tool": "builtin",
          "configHash": "543c25bed460a65c8b4b3f35320e6fbfa8ab4b6cda5d958e097c63f2333d63bc"
        },
        "canonical": "{\"configHash\":\"543c25bed460a65c8b4b3f35320e6fbfa8ab4b6cda5d958e097c63f2333d63bc\",\"input\":{\"artifactVersionIds\":[\"ver_0123456789abcdef0123456789abcdef\"],\"projectId\":\"mini\"},\"tool\":\"builtin\"}",
        "expected": "19fd44ed5b83d75789516f8e3e472c7e1729b30976e783b75a199fc0147189cc"
      },
      {
