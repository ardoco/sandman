    {
      "id": "claim_2c7becc27805451bb31a0ebcab711543",
      "statement": "Links are written in batches of 5000 with active = false and status = candidate (MERGE on the deterministic id, properties only ON CREATE so existing links stay as they are), then activated in the run's single final transaction, which first deactivates earlier active links of the same approach between the run's source and target versions that this run did not produce, then activates every link the run produced, then completes the Run — so readers only ever see active links and never a half-applied run.",
      "evidence": [
        {
          "resource": "repo://contracts/kg/schema.yaml#L10-L10",
          "version": "repo-lines-v1:sha256:79acea318e766e22c9aeb8e6755375fdd52ac4e56548f23e3e9f0158d59f1f7b:"
