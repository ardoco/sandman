            ],
            "targetVersionIds": [
              "ver_fedcba9876543210fedcba9876543210"
            ]
          },
          "tool": "stub-name-match",
          "configHash": "9fe73fc59085844dd08dabfdcd129d617c850c962d8b53a3a981a16c26bd0c9d"
        },
        "canonical": "{\"configHash\":\"9fe73fc59085844dd08dabfdcd129d617c850c962d8b53a3a981a16c26bd0c9d\",\"input\":{\"projectId\":\"mini\",\"sourceVersionIds\":[\"ver_0123456789abcdef0123456789abcdef\"],\"targetVersionIds\":[\"ver_fedcba9876543210fedcba9876543210\"]},\"tool\":\"stub-name-match\"}",
        "expected": "c7407b4ff8b4c31ead56c780dd591f4e31bd40d52887ac3085f1ac3d3a678ab1"
