<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ardoco</groupId>
    <artifactId>sandman-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>sandman-tlr-approach-ardoco</artifactId>
  <name>TLR approach ardoco.</name>

  <dependencies>
    <dependency>
      <groupId>io.github.ardoco</groupId>
      <artifactId>sandman-tlr-approach-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ardoco.tlr</groupId>
      <artifactId>pipeline-tlr</artifactId>
      <version>${ardoco.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <configuration>
              <rules>
                <!-- R-030: LangChain4j comes in through ArDoCo's model-provider; other frameworks stay banned. -->
                <bannedDependencies>
                  <excludes combine.self="override">
                    <exclude>org.springframework.ai</exclude>
                    <exclude>org.bsc.langgraph4j</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
