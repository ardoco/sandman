      {
        "id": "b-orchestrator",
        "virtual_key_id": "vk-orchestrator",
        "max_limit": 10.0,
        "reset_duration": "1M"
      },
      {
        "id": "b-extraction",
        "virtual_key_id": "vk-extraction",
