    {
      "id": "claim_081972b7b60c42a9a0b3aef5568d185c",
      "statement": "Role levels are ordered authenticated=0, viewer=1, triager=2, maintainer=3, admin=4; a user principal's effective project role is their membership capped by the personal token's max_role, and a token with a project_id yields level 0 for every other project; global admin users get at least maintainer in every project, service principals get fixed viewer everywhere.",
      "evidence": [
        {
          "resource": "repo://services/query-service/src/sandman_query/auth.py#L13-L65",
          "version": "repo-lines-v1:sha256:2a3ecb7be5a806f5eb0226d9c247f1cbcbd5449466e3457661064c50ac708968:"
        }
      ]
    },
    {
      "id": "claim_eddb1d5b252e40e7a3f8af5a7063a203",
      "statement": "authorize() raises 403 for plugin callers on any operation outside {queryCypher, getSchema}, 403 for service callers on USER_ONLY operations or any need above viewer, 403 for admin-required operations unless the principal is an unrestricted admin, 404 when the caller's level for the project is 0, and 403 when below the required level.",
