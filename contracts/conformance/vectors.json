  },
  "ingestionId": {
    "rule": "'ing_' + first 32 hex chars of sha256(UTF-8(projectId U+001F decimal seq)); same as stableId('ing', [projectId, str(seq)]).",
    "cases": [
      {
        "input": {
          "projectId": "mediastore",
          "seq": 7
        },
        "expected": "ing_35e685b38d2e94ebd9b9009f05c626df"
      },
      {
        "input": {
          "projectId": "mini",
          "seq": 1
        },
        "expected": "ing_512995c86a77167d1aaf095e8c8b0bed"
      }
    ]
  },
  "traceLinkId": {
    "rule": "'tl_' + first 32 hex chars of sha256(UTF-8(approach, approachVersion, configHash, sourceId, targetId joined by U+001F)) = stableId('tl', [...]) with the per-version Element ids. configHash of a TLR approach = sha256(JCS(effective params of the approach)); of explicit-reference = sha256(JCS(explicitReferences member of config/extraction/plugins.yaml)); sourceId = referenced Requirement, targetId = referring element.",
    "cases": [
      {
        "input": {
          "approach": "stub-name-match",
          "approachVersion": "1",
          "configHash": "9fe73fc59085844dd08dabfdcd129d617c850c962d8b53a3a981a16c26bd0c9d",
          "sourceId": "el_0123456789abcdef0123456789abcdef",
          "targetId": "el_fedcba9876543210fedcba9876543210"
        },
        "expected": "tl_2370852322c95b613f86e8caf4a53ad5"
      },
      {
        "input": {
          "approach": "explicit-reference",
          "approachVersion": "0",
          "configHash": "91a0fb00485d920eb07bbee420b8cbd329bc7e081cf3fe1081ca3734d1483caa",
          "sourceId": "el_0123456789abcdef0123456789abcdef",
          "targetId": "el_fedcba9876543210fedcba9876543210"
        },
        "expected": "tl_eb4a05a6acc5e39d02fc66e996cb9e67",
        "configSource": {
          "explicitReferences": {
            "patterns": [
              "REQ-\\d+",
              "FR-\\d+"
            ]
          }
        },
        "configCanonical": "{\"patterns\":[\"REQ-\\\\d+\",\"FR-\\\\d+\"]}"
      }
    ]
  },
  "evidenceHash": {
    "rule": "sha256 hex of UTF-8(pairs joined by U+001F); pairs = set of 'Element.key=Element.contentHash' of all involved Elements (an involved link contributes both endpoint Elements), duplicates removed, sorted byte-wise by UTF-8. contentHash is required on every Element.",
