{
  "name": "sandman-extraction-agent",
  "description": "Extracts structure and content of ingested artifact versions into the SANDMAN knowledge graph; delegates configured formats to extraction plugins.",
  "version": "0.9.0",
  "supportedInterfaces": [
    {
      "url": "http://extraction-agent:8000/a2a",
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0"
    }
  ],
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extendedAgentCard": false,
    "extensions": [
      {
        "uri": "https://sandman.invalid/a2a/extensions/skill-invocation/v1",
        "description": "Skill id in message.metadata['sandman.skill']; input = one data part; result = task artifact 'result' with one data part; errors in status message metadata 'sandman.error'.",
        "required": true,
        "params": {
          "skills": {
            "extract-artifact-versions": {
              "inputSchema": "https://sandman.invalid/contracts/skills.schema.json#/$defs/ExtractArtifactVersionsInput",
              "outputSchema": "https://sandman.invalid/contracts/skills.schema.json#/$defs/ExtractArtifactVersionsOutput"
            },
            "prune-artifact-data": {
              "inputSchema": "https://sandman.invalid/contracts/skills.schema.json#/$defs/PruneArtifactDataInput",
              "outputSchema": "https://sandman.invalid/contracts/skills.schema.json#/$defs/PruneArtifactDataOutput"
            },
            "derive-architecture-model": {
              "inputSchema": "https://sandman.invalid/contracts/skills.schema.json#/$defs/DeriveArchitectureModelInput",
              "outputSchema": "https://sandman.invalid/contracts/skills.schema.json#/$defs/DeriveArchitectureModelOutput"
            }
          }
        }
      }
    ]
  },
  "securitySchemes": {
    "bearer": {
      "httpAuthSecurityScheme": {
        "scheme": "Bearer",
        "description": "SANDMAN service token"
      }
    }
  },
  "securityRequirements": [
    {
      "schemes": {
        "bearer": {
          "list": []
        }
      }
    }
  ],
  "defaultInputModes": [
    "application/json"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "skills": [
    {
      "id": "extract-artifact-versions",
      "name": "Extract artifact versions",
      "description": "Extracts elements, relations and explicit references of the given artifact versions and writes them to the KG.",
      "tags": [
        "extraction",
        "knowledge-graph"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    },
    {
      "id": "derive-architecture-model",
      "name": "Derive architecture model",
      "description": "Derives a components-only architecture model from the architecture documents of a project without a user architecture model (ExArch port) and retires derived models that a user model supersedes.",
      "tags": [
        "extraction",
        "llm",
        "architecture-model"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ]
    }
  ]
}
