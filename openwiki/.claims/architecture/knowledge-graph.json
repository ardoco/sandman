  "claims": [
    {
      "id": "claim_22ce93c074cc4cdda1c5b23b5d6710ab",
      "statement": "The KG schema is governed by the versioned contract contracts/kg/schema.yaml (v0.2.0), which is the source of truth for writers, contract tests, and the NL-to-Cypher prompt, and follows ADR-0005's decisions L1 (reified TraceLink nodes), P1 (Run provenance nodes), and V1 (immutable artifact-version snapshots).",
      "evidence": [
        {
          "resource": "repo://adr/0005-kg-schema-provenance-versioning.md#L27-L46",
          "version": "repo-lines-v1:sha256:c0102a396c8539488fc08cab9553cc3a8b1e0fb7cdc5e6f7bd8422951fc303b3:"
        },
        {
          "resource": "repo://contracts/kg/schema.yaml#L1-L12",
          "version": "repo-lines-v1:sha256:e3154dc0a5ea64d418f5667f7c828072c3172795a8ffd5d2bd00dc87669a528b:"
        }
      ]
    },
    {
      "id": "claim_38ebdac2b4f24603bcc7084390b6883c",
      "statement": "The single-writer rule assigns exactly one owning component per node type: extraction-agent owns Project, Ingestion, Artifact, ArtifactVersion, Element, and Concept; tlr-agent owns TraceLink (co-owned by extraction-agent for explicit-reference links only); inconsistency-agent owns Inconsistency and StatusChange; each writer owns its own Run nodes.",
      "evidence": [
        {
          "resource": "repo://contracts/kg/schema.yaml#L14-L151",
          "version": "repo-lines-v1:sha256:7c4b8ce1ffc27f3073383273eb936d9a0f6a4c816a5ac7b7ba849269fc415ec4:"
        }
      ]
    },
    {
      "id": "claim_3cc032f53b6740578497ec9573e86483",
      "statement": "Element nodes always carry exactly one secondary label (Requirement, TextUnit, ModelElement, CodeUnit, TestCase) selected by kind; Run nodes record full provenance including agent, tool, model, params, promptIds, inputKey, replayMode, and status.",
      "evidence": [
        {
          "resource": "repo://contracts/kg/schema.yaml#L148-L174",
          "version": "repo-lines-v1:sha256:14e65f3337b61858f343f422bff1c9d1b4ec7001c221636d1136605c93eb5ebd:"
        },
        {
          "resource": "repo://contracts/kg/schema.yaml#L64-L86",
          "version": "repo-lines-v1:sha256:9ec96deccd50bee95937947c98a4fe54bb0a15671e609c777a0fdd55e1bd3516:"
        }
      ]
    },
    {
      "id": "claim_fe34923dd36540c2849332e6c5985c98",
      "statement": "Element.key = artifactId + '#' + localKey is stable across versions; TextUnit local keys are content-based (section slug paths with duplicate counters, sentences keyed by first 12 hex chars of sha256 of the NFC-normalized sentence plus an occurrence counter), so inserting text does not change other keys, and sentenceIndex is a non-key property.",
      "evidence": [
        {
          "resource": "repo://contracts/kg/schema.yaml#L11-L12",
          "version": "repo-lines-v1:sha256:177127ef20e50b1124885c43223b5deafd364d367b96a85346e7837a3df36a66:"
        },
        {
          "resource": "repo://contracts/kg/schema.yaml#L69-L69",
          "version": "repo-lines-v1:sha256:4aed1db130d4c214def1a0bd64b3c65458a36c6149be8db19de922f05662fe85:"
        }
      ]
    },
    {
      "id": "claim_793c6e3238f74696b40e14ffa59f8185",
      "statement": "Inconsistency fingerprints are sha256 over UTF-8 of type, detector id without version, and involved keys sorted byte-wise by UTF-8 joined by U+001F, where an involved key is an Element.key or sourceKey + '->' + targetKey for a TraceLink; this makes re-detection across artifact versions possible.",
      "evidence": [
        {
          "resource": "repo://adr/0005-kg-schema-provenance-versioning.md#L38-L40",
          "version": "repo-lines-v1:sha256:9b589576b42c7fc2b587d3a386fcdb895515557492e84a51c7d6429a839affd8:"
        },
        {
          "resource": "repo://contracts/kg/schema.yaml#L12-L12",
          "version": "repo-lines-v1:sha256:64289a540c17e1746521c20515bb36310bbdd9ce0dc2faae45c4e6565bdcea82:"
        }
      ]
    },
    {
      "id": "claim_0fd83e8688f14d9f88f6b645405d9fb1",
      "statement": "An element is current iff (:Artifact)-[:CURRENT_VERSION]->(:ArtifactVersion)-[:HAS_ELEMENT]->(element); a link is current iff active = true and both endpoints are current; CURRENT_VERSION is at most one per artifact and absent for deleted artifacts.",
      "evidence": [
        {
          "resource": "repo://contracts/kg/schema.yaml#L182-L182",
          "version": "repo-lines-v1:sha256:2d40c65b32a9933e5a4fa6b65f6465d6528d4173c58331f71cd1c5b63b9f7437:"
        },
