    {
      "id": "claim_14105e32471849bb82102a9900b4981c",
      "statement": "Every SANDMAN service exposes the shared.yaml contract GET /healthz (liveness, unauthenticated), GET /readyz (readiness with per-dependency checks, 503 when down) and GET /v1/status (ServiceStatus: service, version, state working iff activeTasks > 0, optional lastActivityAt and free-form details), with /v1/status requiring a service token (401 without).",
      "evidence": [
        {
          "resource": "repo://contracts/openapi/shared.yaml#L133-L159",
          "version": "repo-lines-v1:sha256:0eae5ee86a058104b45f893944163f8cb9f18ae2979b902ed0868197a51332ee:"
        },
        {
