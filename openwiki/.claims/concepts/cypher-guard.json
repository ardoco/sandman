    {
      "id": "claim_921ff61b8469462bbdafab7b2f9e9c5e",
      "statement": "The check_scope post-check walks returned rows recursively and requires every dict carrying a projectId key to match the requested project at any nesting depth, raising ScopeViolation (HTTP 422 'result contains data of another project') and logging a scope_violation event; jsonable converts graph values to property maps with _labels/_type and no internal ids before the check, so it sees exactly the JSON the caller receives. Anchoring relies on the writer invariant that no relationship connects nodes of different projects.",
      "evidence": [
        {
          "resource": "repo://services/query-service/src/sandman_query/reader.py#L21-L52",
          "version": "repo-lines-v1:sha256:3de32689d052eb7c5cdc7691231f53b9e3e73a8103011f65b377674b4d2cfc62:"
