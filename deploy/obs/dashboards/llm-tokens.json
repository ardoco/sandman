{
  "uid": "sandman-llm-tokens",
  "title": "SANDMAN LLM tokens",
  "tags": [
    "sandman"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Input tokens per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, sandman_llm_route, gen_ai_response_model) (rate(gen_ai_client_inference_usage_input_tokens_total[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{sandman_llm_route}} {{gen_ai_response_model}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Output tokens per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, sandman_llm_route, gen_ai_response_model) (rate(gen_ai_client_inference_usage_output_tokens_total[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{sandman_llm_route}} {{gen_ai_response_model}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LLM calls per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, sandman_llm_route, gen_ai_response_model) (rate(gen_ai_client_inference_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{sandman_llm_route}} {{gen_ai_response_model}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM call duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name, sandman_llm_route) (rate(gen_ai_client_inference_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service_name}} {{sandman_llm_route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, sandman_llm_route) (rate(gen_ai_client_inference_duration_seconds_count{error_type!=\"\"}[$__rate_interval])) / sum by (service_name, sandman_llm_route) (rate(gen_ai_client_inference_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{sandman_llm_route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens in selected range by model",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_response_model) (increase(gen_ai_client_inference_usage_input_tokens_total[$__rate_interval]) + increase(gen_ai_client_inference_usage_output_tokens_total[$__rate_interval]))",
          "legendFormat": "{{gen_ai_response_model}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  }
}
