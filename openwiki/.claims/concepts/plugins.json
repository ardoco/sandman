    {
      "id": "claim_b8f70289493e4c36822f6ba32d4cbc7b",
      "statement": "Every plugin must honor the seven obligations of ADR-0012 D-9: never write the KG; no egress (internal network only, prefetch models at build time); LLM calls only via the SANDMAN gateway with its own virtual keys plugin-<id> and plugin-<id>-local; honor llmPolicy (use the -local key for local-only or error out); read artifacts only from storagePath inside /artifacts; send the outbound token only to the configured query-service URL, treating queryServiceUrl in the input as a hint that must match (400 on mismatch, no outbound call); be idempotent because owners retry.",
      "evidence": [
        {
          "resource": "repo://adr/0012-pluggable-approaches-and-detectors.md#L79-L82",
          "version": "repo-lines-v1:sha256:d6987eb8140084d9b3b80348df61579e93acd3e3dcd84929608b07da44599413:"
