        }
      ]
    },
    {
      "id": "claim_554467ef791d440aa7c70a5c589db51a",
      "statement": "Both Java and Python KgClient split access into read transactions (executeRead; Memgraph rejects writes there), write transactions (executeWrite with driver retry of transient errors), and auto-commit (runAutoCommit) required by Memgraph for schema statements and SHOW STORAGE INFO; initSchema executes contracts/kg/init.cypher statement by statement, idempotently.",
      "evidence": [
        {
          "resource": "repo://libs/java/agent-lib/src/main/java/edu/kit/kastel/mcse/ardoco/sandman/agent/KgClient.java#L39-L81",
