    {
      "id": "claim_5bab3a487074430797c5047de8bf96ea",
      "statement": "`make e2e` is the only target that blocks on stack health: it depends on secrets, then runs docker compose -f deploy/docker-compose.yml --profile stubs up -d --build --wait --wait-timeout 300, then SANDMAN_E2E=1 uv run pytest tests/e2e -q; the walking-skeleton test itself skips unless SANDMAN_E2E is set and talks to http://127.0.0.1:8080 (the edge proxy).",
      "evidence": [
        {
          "resource": "repo://Makefile#L45-L47",
