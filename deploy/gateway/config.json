      },
      {
        "id": "b-inconsistency",
        "virtual_key_id": "vk-inconsistency",
        "max_limit": 30.0,
        "reset_duration": "1M"
      },
      {
        "id": "b-query",
        "virtual_key_id": "vk-query",
        "max_limit": 10.0,
        "reset_duration": "1M"
      },
      {
        "id": "b-experiments",
        "virtual_key_id": "vk-experiments",
        "max_limit": 50.0,
        "reset_duration": "1M"
      }
    ],
    "rate_limits": [
      {
        "id": "rl-default",
        "request_max_limit": 60,
        "request_reset_duration": "1m",
        "token_max_limit": 200000,
        "token_reset_duration": "1h"
      },
      {
        "id": "rl-heavy",
        "request_max_limit": 300,
        "request_reset_duration": "1m",
        "token_max_limit": 2000000,
        "token_reset_duration": "1h"
      }
    ]
  }
