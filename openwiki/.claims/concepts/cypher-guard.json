  "claims": [
    {
      "id": "claim_deffd1fadd484461acbf18301b1b3a6c",
      "statement": "The query-service executes every query (user Cypher, NL stub, fixed export templates) through one pipeline: reserved-parameter rejection, guard.check parse, LIMIT limit+1 and QUERY MEMORY LIMIT appended, Reader read transaction fetching at most limit+1 rows, then a check_scope post-check on every returned map with a projectId, at any depth.",
      "evidence": [
        {
          "resource": "repo://services/query-service/src/sandman_query/query.py#L98-L142",
          "version": "repo-lines-v1:sha256:f2ca653b936047f4da394afa30b352dee4078a882415760c64118c3292ecc6d9:"
        },
        {
          "resource": "repo://services/query-service/src/sandman_query/reader.py#L42-L52",
          "version": "repo-lines-v1:sha256:4c741e69740104c4a16c57ca1eb5e5a03945ec1c42b53efb1f2303897985b4ed:"
        }
      ]
    },
    {
      "id": "claim_38e218346de142e58ebe4f92558de046",
      "statement": "The guard is a recursive-descent parser for an allowlisted read subset that rejects anything it does not understand, chosen over ANTLR grammars because a grammar accepts the full language whereas the guard needs deny-by-default (decision D-2, ADR-0009 amendment).",
      "evidence": [
        {
          "resource": "repo://docs/notes/cypher-guard.md#L5-L21",
          "version": "repo-lines-v1:sha256:6d4c6317e0484942ff108a74808a20e9de51a4ce231c7f6db50f11a3bbb471fc:"
        },
        {
          "resource": "repo://services/query-service/src/sandman_query/guard.py#L1-L31",
          "version": "repo-lines-v1:sha256:2e24b55387d1c376ea3ffa3d611a036cbdd04bc39bc42f4c36be137f0f163c7c:"
        }
      ]
    },
    {
      "id": "claim_77ff7761b9c94036b3591e8f66452028",
      "statement": "The DENIED keyword set rejects every write/admin/procedure clause (CALL, CREATE, MERGE, SET, DELETE, DETACH, REMOVE, FOREACH, LOAD, SHOW, DUMP, TERMINATE, EXPLAIN, PROFILE, DROP, GRANT/REVOKE, etc.) by name, even for global admins in unscoped mode; semicolon-chained second statements and caller-written QUERY MEMORY LIMIT are also rejected.",
      "evidence": [
        {
          "resource": "repo://services/query-service/src/sandman_query/guard.py#L18-L27",
          "version": "repo-lines-v1:sha256:5e5b0396883435d5482f5b013ab52fb708274a6d6b0faea9984713c5fbcd539a:"
        },
        {
          "resource": "repo://services/query-service/src/sandman_query/guard.py#L273-L276",
          "version": "repo-lines-v1:sha256:8c6cd149edad4af8a240f406c944dc5f391eca7bf622ccfdc5cf3bb896d7cc98:"
        }
      ]
    },
    {
      "id": "claim_ece0520865e140f689a707927db9f837",
      "statement": "Guard hard limits: MAX_LENGTH 20000 characters and MAX_DEPTH 12 expression nesting (RecursionError converted to 'query nested too deeply').",
