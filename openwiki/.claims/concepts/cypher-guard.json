    {
      "id": "claim_5cd629aee7bc4c758b853cef6b071623",
      "statement": "Unscoped queries (no projectId) are allowed only for unrestricted global admins and skip only the anchoring rule, while the clause allowlist still applies; when a project is named, even a global admin query is anchored. The endpoints /v1/query/cypher and /v1/query/nl gate via queryCypher/queryNl min-roles and plugin grants.",
      "evidence": [
        {
          "resource": "repo://services/query-service/src/sandman_query/app.py#L360-L372",
