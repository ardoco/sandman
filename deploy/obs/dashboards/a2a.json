{
  "uid": "sandman-a2a",
  "title": "SANDMAN A2A tasks",
  "tags": [
    "sandman"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Task rate by agent and skill",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (sandman_agent, sandman_skill) (rate(sandman_a2a_task_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{sandman_agent}} {{sandman_skill}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Task duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, sandman_agent, sandman_skill) (rate(sandman_a2a_task_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{sandman_agent}} {{sandman_skill}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Failures and rejections per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (sandman_agent, sandman_skill, sandman_outcome) (rate(sandman_a2a_task_duration_seconds_count{sandman_outcome!=\"completed\"}[$__rate_interval]))",
          "legendFormat": "{{sandman_agent}} {{sandman_skill}} {{sandman_outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tasks by outcome (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (sandman_outcome) (increase(sandman_a2a_task_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{sandman_outcome}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  }
}
