    },
    {
      "id": "claim_8ee5f006e4af400c899bffbbbf8c98a4",
      "statement": "GET /v1/status returns the shared ServiceStatus shape: service llm-replay, version (SANDMAN_VERSION, default dev), state working iff activeTasks > 0, optional lastActivityAt, and details {mode, experiment (the records dir base name), entries, hits, misses, recorded, forwarded}; only the proxied /openai route is counted as active tasks, so polling the status and health endpoints never makes the service appear working.",
      "evidence": [
