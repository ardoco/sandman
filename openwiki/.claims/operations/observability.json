    {
      "id": "claim_9d5865ad0b244b46b19be0630c84f1c2",
      "statement": "The orchestrator and llm-replay derive status differently from the tracker pattern: the orchestrator's GET /v1/status sets tracker.active/last_activity from its SQLite state (runningSteps, max updated_at of workflows) and returns snapshot(counts) as details, while llm-replay counts proxied LLM requests in an active counter and exposes mode/experiment/entries/hits/misses as details.",
      "evidence": [
        {
          "resource": "repo://services/llm-replay/src/sandman_llm_replay/app.py#L202-L215",
