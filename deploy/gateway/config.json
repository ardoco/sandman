{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enforce_auth_on_inference": true,
    "enable_logging": true
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "./config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "./logs.db"
    }
  },
  "providers": {
    "openai": {
      "keys": [
        {
          "name": "openai-1",
          "value": "env.OPENAI_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ]
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-1",
          "value": "env.OPENROUTER_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ]
    },
    "ollama": {
      "keys": [
        {
          "name": "ollama-selfhosted",
          "value": "env.SELFHOSTED_LLM_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0,
          "ollama_key_config": {
            "url": "env.SELFHOSTED_LLM_URL"
          }
        }
      ]
    }
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "admin",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD"
    },
    "virtual_keys": [
      {
        "id": "vk-orchestrator",
        "name": "orchestrator",
        "value": "env.VK_ORCHESTRATOR",
        "is_active": true,
        "rate_limit_id": "rl-default",
        "provider_configs": [
          {
            "provider": "openai",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "openrouter",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "ollama",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          }
        ]
      },
      {
        "id": "vk-extraction",
        "name": "extraction",
        "value": "env.VK_EXTRACTION",
        "is_active": true,
        "rate_limit_id": "rl-default",
        "provider_configs": [
          {
            "provider": "openai",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "openrouter",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
