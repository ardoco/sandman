      {
        "name": "unsorted elements",
        "involved": {
          "elements": [
            {
              "key": "art_bb#mini.MediaCache",
              "contentHash": "3e23e8160039594a33894f6564e1b1348bbd7a0088d42c4acb73eeaed59c009d"
            },
            {
              "key": "art_aa#REQ-2",
              "contentHash": "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb"
            }
          ]
        },
        "sortedPairs": [
          "art_aa#REQ-2=ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb",
          "art_bb#mini.MediaCache=3e23e8160039594a33894f6564e1b1348bbd7a0088d42c4acb73eeaed59c009d"
        ],
        "expected": "37a2dcdbc799abad57ac8fcf880f379598af7ae1ddec4750a7cb5f2d7494f5b3"
      },
      {
        "name": "duplicate element and link endpoints",
